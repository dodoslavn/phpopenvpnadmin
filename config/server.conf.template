# OpenVPN Server Configuration
# Generated by phpopenvpnadmin — do not edit manually

port {{PORT}}
proto udp
dev tun

# Certificates
ca   /var/lib/vpnadmin/pki/ca.crt
cert /var/lib/vpnadmin/pki/server.crt
key  /var/lib/vpnadmin/pki/server.key
dh   /var/lib/vpnadmin/pki/dh.pem

# TLS authentication
tls-auth /var/lib/vpnadmin/pki/ta.key 0
key-direction 0

# Cipher settings
cipher AES-256-GCM
auth SHA256
tls-version-min 1.2

# VPN subnet
server 10.8.0.0 255.255.255.0

# Push routes and DNS to clients
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 10.8.0.1"

# Keepalive
keepalive 10 120

# Reduce OpenVPN daemon privileges after init
user nobody
group nogroup
persist-key
persist-tun

# Logging
status      /var/log/vpnadmin/openvpn-status.log
log-append  /var/log/vpnadmin/openvpn.log
verb 3

# Username/password authentication (in addition to cert)
auth-user-pass-verify /usr/local/bin/vpn-check-password.sh via-env
username-as-common-name
script-security 2

# Revocation list (updated when a cert is revoked)
crl-verify /var/lib/vpnadmin/pki/crl.pem
