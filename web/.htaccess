RewriteEngine On

# Skip rewriting for real files and directories (assets, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^login/?$      login.php         [L,QSA]
RewriteRule ^logout/?$     logout.php        [L,QSA]
RewriteRule ^setup/?$      setup/wizard.php  [L,QSA]

RewriteRule ^dashboard/?$  admin/dashboard.php [L,QSA]
RewriteRule ^server/?$     admin/server.php    [L,QSA]
RewriteRule ^settings/?$   admin/settings.php  [L,QSA]
RewriteRule ^users/?$      admin/users.php     [L,QSA]

RewriteRule ^profiles/?$   user/dashboard.php  [L,QSA]
RewriteRule ^profile/?$    user/profile.php    [L,QSA]
RewriteRule ^account/?$    user/account.php    [L,QSA]
